# IA — Groq (requerido para generación y análisis con IA)
# Obtén tu key en https://console.groq.com
GROQ_API_KEY=

# Email — Resend (requerido para recuperación de contraseña)
# Obtén tu key en https://resend.com
RESEND_API_KEY=

# URL pública de la app (requerido para links en emails de reset)
# En desarrollo: http://localhost:3000
# En producción: https://tu-dominio.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secreto para firmar tokens de reset de contraseña
# Genera uno con: openssl rand -base64 32
RESET_TOKEN_SECRET=

# API pública v1 — clave que tus integradores deben enviar en X-API-Key
CONTRACTAI_API_KEY=
